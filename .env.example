# ============================================================================
# FarmFinder 환경 변수 설정 (.env 파일로 복사하여 값을 입력하세요)
# cp .env.example .env
# ============================================================================

# 1. Google Gemini API (필수 - 에이전트 추론 및 Google 웹 검색 Grounding)
# 발급처: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 구글 검색 Grounding 전용 모델 (비워두면 GEMINI_MODEL 사용)
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# (선택) Serper.dev API 키 - Gemini 무료 티어에서 Google Search Grounding이 제한될 때 대체 구글 검색용
# 발급처: https://serper.dev
SERPER_API_KEY=

# 2. 네이버 검색 Open API (필수 - 뉴스, 블로그, 웹문서, 지역업체 검색)
# 발급처: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 3. 공공데이터포털 GAP 인증정보 OpenAPI (필수 - 국립농산물품질관리원 농산물우수관리 인증정보)
# 발급처: https://www.data.go.kr/data/15141807/openapi.do (일반 인증키 Encoding 또는 Decoding 둘 다 지원)
DATA_GO_KR_API_KEY=
GAP_API_URL=https://apis.data.go.kr/1543145/GAPCERTINFO/getCertDataList

# 4. 행정안전부 도로명주소 검색 Open API (필수 - 세부 도로명/지번/법정리 주소 검증)
# 발급처: https://business.juso.go.kr/addrlink/openApi/apiReqst.do
JUSO_API_KEY=

# 5. Google Sheets 저장 연동 (둘 중 편한 방식 하나만 설정하면 됩니다)
# 기본 연결 시트: https://docs.google.com/spreadsheets/d/1T26pUoB3u77KnELhB536r8vhsthrhAf1X14igLfGZdA/edit
GOOGLE_SHEET_ID=1T26pUoB3u77KnELhB536r8vhsthrhAf1X14igLfGZdA
GOOGLE_SHEET_TAB=탐색결과

# [방식 A - 가장 간편] 시트 내 Apps Script 웹 앱 배포 URL
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=

# [방식 B - 정식 API] Google Cloud 서비스 계정 JSON 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=

# 서버 포트 설정
HOST=0.0.0.0
PORT=8000
